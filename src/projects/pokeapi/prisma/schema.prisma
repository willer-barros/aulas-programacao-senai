generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pokemon {
  id           Int      @id @default(autoincrement())
  numero       Int
  nome         String
  tipo         String
  nivel        Int      @default(1)
  capturadoEm  DateTime @default(now())

  @@index([tipo])
}
